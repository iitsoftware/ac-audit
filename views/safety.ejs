<!-- Company Tabs (read-only) -->
<div class="tab-bar" id="company-tab-bar">
  <div class="tab-bar-scroll" id="company-tabs"></div>
</div>

<!-- Department Tabs (read-only) -->
<div class="tab-bar tab-bar-secondary" id="dept-tab-bar" style="display:none">
  <div class="tab-bar-scroll" id="dept-tabs"></div>
</div>

<!-- Main Content -->
<main class="main-content-full" id="main-content">
  <div class="empty-state" id="empty-state">Firma ausw&auml;hlen</div>
  <div id="safety-content" style="display:none">
    <div class="empty-state-inline" id="safety-dept-empty">Abteilung ausw&auml;hlen</div>

    <!-- Level 1: Jahre (Kachel-Grid) -->
    <div id="safety-years" style="display:none">
      <div class="audit-section-header">
        <h3>Jahre</h3>
        <button type="button" class="btn-icon" id="btn-add-year" title="Jahr hinzuf&uuml;gen">+</button>
      </div>
      <div class="plan-tile-grid" id="years-grid"></div>
    </div>

    <!-- Level 2: Jahres-Detail (SRB Meetings + Sicherheitsziele des Jahres) -->
    <div id="year-detail" style="display:none">
      <div class="meeting-detail-header">
        <button type="button" class="btn btn-secondary" id="year-detail-back">Zur&uuml;ck</button>
        <h2 id="year-detail-title">SRB Meetings</h2>
      </div>

      <!-- Tab-Leiste des Jahres. Markup, Klassen und aria-selected-Toggle wie die
           Einstellungs-Tabs in views/settings.ejs; der Toggle steht als kleines
           Inline-Script am Ende dieser Datei. -->
      <div class="settings-tabs" id="year-tabs" role="tablist" aria-label="Jahres-Detail">
        <button type="button" class="settings-tab active" id="year-tab-meetings" data-tab="meetings" role="tab" aria-selected="true" aria-controls="year-panel-meetings">SRB Meetings</button>
        <button type="button" class="settings-tab" id="year-tab-objectives" data-tab="objectives" role="tab" aria-selected="false" aria-controls="year-panel-objectives">Sicherheitsziele &amp; SPI</button>
      </div>

      <!-- Tab 1: SRB Meetings (CM-025) -->
      <div class="settings-tab-content active" id="year-panel-meetings" role="tabpanel" aria-labelledby="year-tab-meetings">
        <div class="audit-section">
          <div class="audit-section-header">
            <h3>SRB Meetings</h3>
            <button type="button" class="btn-icon" id="btn-add-meeting" title="Meeting hinzuf&uuml;gen">+</button>
          </div>
          <div id="meetings-table"></div>
        </div>
      </div>

      <!-- Tab 2: Sicherheitsziele &amp; SPI (CM-006) -->
      <div class="settings-tab-content" id="year-panel-objectives" role="tabpanel" aria-labelledby="year-tab-objectives">
        <div class="audit-section">
          <div class="audit-section-header">
            <h3>Sicherheitsziele &amp; SPI</h3>
            <div class="section-header-actions">
              <!-- Mehrfachauswahl: die Zeilen-Checkboxen rendert public/safety.js in
                   die Katalogtabelle, Select-all und Teilen-Button leben hier in der
                   Kopfleiste des Abschnitts. .has-selection l&auml;sst den Teilen-Button
                   blinken, sobald etwas ausgew&auml;hlt ist. -->
              <span class="select-header" id="objectives-select-header">
                <label><input type="checkbox" id="objectives-select-all" title="Alle ausw&auml;hlen"><span class="sr-only">Alle Ziele ausw&auml;hlen</span></label>
                <button type="button" class="icon-btn select-share-btn" id="objectives-share" aria-label="Ausgew&auml;hlte Bewertungen als PDF exportieren"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2"/><polyline points="12 3 12 15"/><polyline points="8 7 12 3 16 7"/></svg></button>
              </span>
              <button type="button" class="btn btn-secondary" id="btn-objectives-pdf">Katalog-PDF</button>
              <button type="button" class="btn-icon" id="btn-add-objective" title="Ziel hinzuf&uuml;gen">+</button>
            </div>
          </div>
          <!-- Katalogtabelle — Bef&uuml;llung durch public/safety.js -->
          <div id="objectives-table"></div>
          <!-- Leerzustand: public/safety.js blendet ihn ein, solange das Jahr keine
               Ziele hat, setzt die Jahreszahl des Vorjahres ein und blendet den
               &Uuml;bernehmen-Button aus, wenn es kein Vorjahr mit Katalog gibt.
               Die Beschriftung steckt in einem eigenen <span>, damit die
               Jahreszahl nicht zum Flex-Item des .btn wird (sonst Extra-Gaps). -->
          <div class="empty-state-inline" id="objectives-empty" style="display:none">
            <p>Noch keine Sicherheitsziele f&uuml;r dieses Jahr.</p>
            <div class="empty-state-actions">
              <button type="button" class="btn btn-secondary" id="btn-copy-prev-catalog"><span>Katalog aus <span id="objectives-prev-year"></span> &uuml;bernehmen</span></button>
              <button type="button" class="btn btn-secondary" id="btn-load-default-catalog">Standard-Katalog laden</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Level 3: Meeting Full-Page Detail (Add / Edit) — CM-025 -->
    <div id="meeting-detail" style="display:none">
      <div class="meeting-detail-header">
        <button type="button" class="btn btn-secondary" id="meeting-detail-back">Zur&uuml;ck</button>
        <h2 id="meeting-detail-title">Meeting hinzuf&uuml;gen</h2>
        <button type="button" class="btn btn-secondary" id="meeting-detail-pdf" style="display:none">PDF</button>
      </div>
      <form id="meeting-form">
        <div class="audit-section">
          <input type="hidden" id="meeting-form-id">
          <div class="form-row">
            <div class="form-group">
              <label for="meeting-form-date">Datum</label>
              <input type="text" id="meeting-form-date" placeholder="TT.MM.JJJJ" pattern="\d{2}\.\d{2}\.\d{4}" inputmode="numeric" title="TT.MM.JJJJ">
            </div>
            <div class="form-group">
              <label for="meeting-form-location">Ort</label>
              <input type="text" id="meeting-form-location">
            </div>
          </div>
          <div class="form-group">
            <label for="meeting-form-meeting-no">SRB MEETING NO</label>
            <input type="text" id="meeting-form-meeting-no">
          </div>
          <div class="form-group">
            <label for="meeting-form-participants">Teilnehmer</label>
            <textarea id="meeting-form-participants" rows="4"></textarea>
          </div>
          <div class="form-group">
            <label for="meeting-form-participants-excused">Teilnehmer entschuldigt</label>
            <textarea id="meeting-form-participants-excused" rows="3"></textarea>
          </div>
          <div class="form-group">
            <label for="meeting-form-topics">THEMEN</label>
            <textarea id="meeting-form-topics" rows="6"></textarea>
          </div>

          <hr class="form-divider">

          <div class="form-group">
            <label for="meeting-form-general-result">Allgemeines Ergebnis</label>
            <textarea id="meeting-form-general-result" rows="6"></textarea>
          </div>
          <div class="form-group">
            <label for="meeting-form-positives">Positives</label>
            <textarea id="meeting-form-positives" rows="6"></textarea>
          </div>
          <div class="form-group">
            <label for="meeting-form-negatives">Negatives</label>
            <textarea id="meeting-form-negatives" rows="6"></textarea>
          </div>
          <div class="form-group">
            <label for="meeting-form-improvements">Verbesserungen</label>
            <textarea id="meeting-form-improvements" rows="6"></textarea>
          </div>
          <div class="form-group">
            <label for="meeting-form-remarks">Bemerkungen</label>
            <textarea id="meeting-form-remarks" rows="6"></textarea>
          </div>
          <div class="form-group">
            <!-- Jahreszahl wird beim &Ouml;ffnen des Meetings aus dem gew&auml;hlten Jahr + 1 gesetzt -->
            <label for="meeting-form-outlook">Vorschau <span id="meeting-form-outlook-year"></span> (objectives, targets usw.)</label>
            <textarea id="meeting-form-outlook" rows="6"></textarea>
          </div>
        </div>
        <div class="dialog-footer">
          <button type="button" class="btn btn-secondary" id="meeting-btn-cancel">Abbrechen</button>
          <button type="submit" class="btn btn-primary" id="meeting-btn-save">Speichern</button>
        </div>
      </form>

      <!-- Standard-Themen aus den Einstellungen; werden beim Anlegen eines neuen
           Protokolls in das THEMEN-Feld kopiert und sind dort frei editierbar.
           Bewusst ein Textarea und kein <script>-Block: <%%= %> escaped den Inhalt
           korrekt f&uuml;r den Textarea-Kontext und erh&auml;lt die Zeilenumbr&uuml;che verbatim. -->
      <textarea id="srb-default-topics" hidden><%= srbDefaultTopics %></textarea>
    </div>

    <!-- Level 3: SPI-Bewertung Full-Page Detail (Add / Edit) — CM-006 -->
    <div id="spi-detail" style="display:none">
      <div class="meeting-detail-header">
        <button type="button" class="btn btn-secondary" id="spi-detail-back">Zur&uuml;ck</button>
        <h2 id="spi-detail-title">Bewertung</h2>
        <button type="button" class="btn btn-secondary" id="spi-detail-pdf" style="display:none">PDF</button>
      </div>
      <form id="spi-form">
        <div class="audit-section">
          <input type="hidden" id="spi-form-id">
          <input type="hidden" id="spi-form-objective-id">
          <!-- Ziel, SPT und Intervall als Lesekontext der Bewertung —
               gef&uuml;llt von public/safety.js aus dem Katalogeintrag bzw., bei einer
               bereits unterschriebenen Bewertung, aus deren *_snapshot-Feldern. -->
          <div class="cap-info-block" id="spi-form-context"></div>

          <div class="form-row">
            <div class="form-group">
              <label for="spi-form-eval-date">Datum der Feststellung</label>
              <input type="text" id="spi-form-eval-date" placeholder="TT.MM.JJJJ" pattern="\d{2}\.\d{2}\.\d{4}" inputmode="numeric" title="TT.MM.JJJJ">
            </div>
            <div class="form-group">
              <label for="spi-form-spi-value">SPI (gemessener Wert)</label>
              <input type="text" id="spi-form-spi-value">
            </div>
          </div>
          <div class="form-group">
            <label for="spi-form-result-text">Ergebnis</label>
            <input type="text" id="spi-form-result-text" placeholder="z.B. Erf&uuml;llt, Nicht erf&uuml;llt, -2">
          </div>
          <div class="form-group">
            <!-- Bare label + aria-labelledby wie bei den Wochentagen in
                 views/settings.ejs: die Gruppe hat keine eigene Control. -->
            <label id="spi-form-rating-label">Bewertung</label>
            <div class="radio-row" role="radiogroup" aria-labelledby="spi-form-rating-label">
              <label class="radio-check"><input type="radio" name="spi-rating" id="spi-form-rating-positiv" value="POSITIV"> Positiv</label>
              <label class="radio-check"><input type="radio" name="spi-rating" id="spi-form-rating-negativ" value="NEGATIV"> Negativ</label>
              <!-- Vorschlag aus spt_direction/spt_value, gesetzt von public/safety.js -->
              <span class="form-hint" id="spi-form-rating-hint" aria-live="polite"></span>
            </div>
          </div>
          <div class="form-group">
            <label for="spi-form-cause-analysis">Ursachenanalyse</label>
            <textarea id="spi-form-cause-analysis" rows="5"></textarea>
          </div>
          <div class="form-group">
            <label for="spi-form-measures">Ma&szlig;nahmen</label>
            <textarea id="spi-form-measures" rows="5"></textarea>
          </div>

          <hr class="form-divider">

          <div class="form-group">
            <label for="spi-form-decision">Entscheidung des Safety Managers</label>
            <textarea id="spi-form-decision" rows="5"></textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="spi-form-decision-place">Ort</label>
              <input type="text" id="spi-form-decision-place">
            </div>
            <div class="form-group">
              <label for="spi-form-decided-at">Datum der Unterschrift</label>
              <input type="text" id="spi-form-decided-at" placeholder="TT.MM.JJJJ" pattern="\d{2}\.\d{2}\.\d{4}" inputmode="numeric" title="TT.MM.JJJJ">
            </div>
          </div>
          <div class="form-group">
            <label for="spi-form-copy-to">Kopie an</label>
            <input type="text" id="spi-form-copy-to">
          </div>
        </div>
        <div class="dialog-footer">
          <button type="button" class="btn btn-secondary" id="spi-btn-cancel">Abbrechen</button>
          <button type="submit" class="btn btn-primary" id="spi-btn-save">Speichern</button>
        </div>
      </form>
    </div>

  </div>
</main>

<!-- Jahr Add / Edit dialog -->
<dialog id="year-dialog" aria-labelledby="year-dialog-title">
  <div class="dialog-header" id="year-dialog-title">Jahr hinzuf&uuml;gen</div>
  <form id="year-form" method="dialog">
    <div class="dialog-body">
      <input type="hidden" id="year-form-id">
      <div class="form-group">
        <label for="year-form-year">Jahr *</label>
        <input type="number" id="year-form-year" required min="2000" max="2099" value="<%= new Date().getFullYear() %>">
      </div>
    </div>
    <div class="dialog-footer">
      <button type="button" class="btn btn-secondary" id="year-btn-cancel">Abbrechen</button>
      <button type="submit" class="btn btn-primary" id="year-btn-save">Speichern</button>
    </div>
  </form>
</dialog>

<!-- Sicherheitsziel Add / Edit dialog (Katalogfelder CM-006) -->
<dialog id="objective-dialog" aria-labelledby="objective-dialog-title">
  <div class="dialog-header" id="objective-dialog-title">Sicherheitsziel hinzuf&uuml;gen</div>
  <form id="objective-form" method="dialog">
    <div class="dialog-body">
      <input type="hidden" id="objective-form-id">
      <div class="form-group">
        <label for="objective-form-title">Titel *</label>
        <input type="text" id="objective-form-title" required placeholder="z.B. Gefahrenliste">
      </div>
      <div class="form-group">
        <label for="objective-form-objective">Zielsatz</label>
        <textarea id="objective-form-objective" rows="3" placeholder="Unser Ziel ist es, &hellip;"></textarea>
      </div>
      <div class="form-group">
        <label for="objective-form-spt">SPT-Anzeigetext</label>
        <input type="text" id="objective-form-spt" placeholder="z.B. Mindestens 20 Stck.">
      </div>
      <div class="form-row">
        <div class="form-group">
          <!-- Maschinenlesbare H&auml;lfte des SPT: nur f&uuml;r den Bewertungsvorschlag,
               gedruckt wird immer der Anzeigetext oben. -->
          <label for="objective-form-spt-direction">SPT-Richtung</label>
          <select id="objective-form-spt-direction">
            <option value="">&mdash;</option>
            <option value="MIN">Mindestens (MIN)</option>
            <option value="MAX">H&ouml;chstens (MAX)</option>
          </select>
        </div>
        <div class="form-group">
          <label for="objective-form-spt-value">SPT-Wert</label>
          <input type="number" id="objective-form-spt-value" step="any">
        </div>
      </div>
      <div class="form-group">
        <label for="objective-form-spi-description">SPI-Beschreibung</label>
        <textarea id="objective-form-spi-description" rows="3"></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="objective-form-interval-months">Intervall (Monate)</label>
          <input type="number" id="objective-form-interval-months" min="1" max="60" value="12">
        </div>
        <div class="form-group">
          <label for="objective-form-active">Aktiv</label>
          <select id="objective-form-active">
            <option value="1">Ja</option>
            <option value="0">Nein</option>
          </select>
        </div>
      </div>
    </div>
    <div class="dialog-footer">
      <button type="button" class="btn btn-secondary" id="objective-btn-cancel">Abbrechen</button>
      <button type="submit" class="btn btn-primary" id="objective-btn-save">Speichern</button>
    </div>
  </form>
</dialog>

<script>
  // Tab-Toggle des Jahres-Details — gleiche Mechanik wie in views/settings.ejs,
  // aber auf #year-tabs begrenzt. Bewusst kein localStorage: welcher Tab offen
  // ist, geh&ouml;rt zur fl&uuml;chtigen Navigation innerhalb eines Jahres.
  // public/safety.js darf zus&auml;tzliche click-Listener auf dieselben Buttons legen
  // (Nachladen der Katalogdaten) und mit .click() auf einen Tab zur&uuml;ckschalten.
  document.querySelectorAll('#year-tabs .settings-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('#year-tabs .settings-tab').forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      document.querySelectorAll('#year-detail > .settings-tab-content').forEach(c => c.classList.remove('active'));
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      document.getElementById(tab.getAttribute('aria-controls')).classList.add('active');
    });
  });
</script>
