<!-- Company Tabs (read-only) -->
<div class="tab-bar" id="company-tab-bar">
  <div class="tab-bar-scroll" id="company-tabs"></div>
</div>

<!-- Department Tabs (read-only) -->
<div class="tab-bar tab-bar-secondary" id="dept-tab-bar" style="display:none">
  <div class="tab-bar-scroll" id="dept-tabs"></div>
</div>

<!-- Main Content -->
<main class="main-content-full" id="main-content">
  <div class="empty-state" id="empty-state">Firma ausw&auml;hlen</div>
  <div id="safety-content" style="display:none">
    <div class="empty-state-inline" id="safety-dept-empty">Abteilung ausw&auml;hlen</div>

    <!-- Level 1: Jahre (Kachel-Grid) -->
    <div id="safety-years" style="display:none">
      <div class="audit-section-header">
        <h3>Jahre</h3>
        <button type="button" class="btn-icon" id="btn-add-year" title="Jahr hinzuf&uuml;gen">+</button>
      </div>
      <div class="plan-tile-grid" id="years-grid"></div>
    </div>

    <!-- Level 2: Jahres-Detail (SRB Meetings des Jahres) -->
    <div id="year-detail" style="display:none">
      <div class="meeting-detail-header">
        <button type="button" class="btn btn-secondary" id="year-detail-back">Zur&uuml;ck</button>
        <h2 id="year-detail-title">SRB Meetings</h2>
      </div>
      <div class="audit-section">
        <div class="audit-section-header">
          <h3>SRB Meetings</h3>
          <button type="button" class="btn-icon" id="btn-add-meeting" title="Meeting hinzuf&uuml;gen">+</button>
        </div>
        <div id="meetings-table"></div>
      </div>
    </div>

    <!-- Level 3: Meeting Full-Page Detail (Add / Edit) — CM-025 -->
    <div id="meeting-detail" style="display:none">
      <div class="meeting-detail-header">
        <button type="button" class="btn btn-secondary" id="meeting-detail-back">Zur&uuml;ck</button>
        <h2 id="meeting-detail-title">Meeting hinzuf&uuml;gen</h2>
        <button type="button" class="btn btn-secondary" id="meeting-detail-pdf" style="display:none">PDF</button>
      </div>
      <form id="meeting-form">
        <div class="audit-section">
          <input type="hidden" id="meeting-form-id">
          <div class="form-row">
            <div class="form-group">
              <label for="meeting-form-date">Datum</label>
              <input type="text" id="meeting-form-date" placeholder="TT.MM.JJJJ" pattern="\d{2}\.\d{2}\.\d{4}" inputmode="numeric" title="TT.MM.JJJJ">
            </div>
            <div class="form-group">
              <label for="meeting-form-location">Ort</label>
              <input type="text" id="meeting-form-location">
            </div>
          </div>
          <div class="form-group">
            <label for="meeting-form-meeting-no">SRB MEETING NO</label>
            <input type="text" id="meeting-form-meeting-no">
          </div>
          <div class="form-group">
            <label for="meeting-form-participants">Teilnehmer</label>
            <textarea id="meeting-form-participants" rows="4"></textarea>
          </div>
          <div class="form-group">
            <label for="meeting-form-participants-excused">Teilnehmer entschuldigt</label>
            <textarea id="meeting-form-participants-excused" rows="3"></textarea>
          </div>
          <div class="form-group">
            <label for="meeting-form-topics">THEMEN</label>
            <textarea id="meeting-form-topics" rows="6"></textarea>
          </div>

          <hr class="form-divider">

          <div class="form-group">
            <label for="meeting-form-general-result">Allgemeines Ergebnis</label>
            <textarea id="meeting-form-general-result" rows="6"></textarea>
          </div>
          <div class="form-group">
            <label for="meeting-form-positives">Positives</label>
            <textarea id="meeting-form-positives" rows="6"></textarea>
          </div>
          <div class="form-group">
            <label for="meeting-form-negatives">Negatives</label>
            <textarea id="meeting-form-negatives" rows="6"></textarea>
          </div>
          <div class="form-group">
            <label for="meeting-form-improvements">Verbesserungen</label>
            <textarea id="meeting-form-improvements" rows="6"></textarea>
          </div>
          <div class="form-group">
            <label for="meeting-form-remarks">Bemerkungen</label>
            <textarea id="meeting-form-remarks" rows="6"></textarea>
          </div>
          <div class="form-group">
            <!-- Jahreszahl wird beim &Ouml;ffnen des Meetings aus dem gew&auml;hlten Jahr + 1 gesetzt -->
            <label for="meeting-form-outlook">Vorschau <span id="meeting-form-outlook-year"></span> (objectives, targets usw.)</label>
            <textarea id="meeting-form-outlook" rows="6"></textarea>
          </div>
        </div>
        <div class="dialog-footer">
          <button type="button" class="btn btn-secondary" id="meeting-btn-cancel">Abbrechen</button>
          <button type="submit" class="btn btn-primary" id="meeting-btn-save">Speichern</button>
        </div>
      </form>
    </div>

  </div>
</main>

<!-- Jahr Add / Edit dialog -->
<dialog id="year-dialog" aria-labelledby="year-dialog-title">
  <div class="dialog-header" id="year-dialog-title">Jahr hinzuf&uuml;gen</div>
  <form id="year-form" method="dialog">
    <div class="dialog-body">
      <input type="hidden" id="year-form-id">
      <div class="form-group">
        <label for="year-form-year">Jahr *</label>
        <input type="number" id="year-form-year" required min="2000" max="2099" value="<%= new Date().getFullYear() %>">
      </div>
    </div>
    <div class="dialog-footer">
      <button type="button" class="btn btn-secondary" id="year-btn-cancel">Abbrechen</button>
      <button type="submit" class="btn btn-primary" id="year-btn-save">Speichern</button>
    </div>
  </form>
</dialog>
